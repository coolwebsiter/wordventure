    <!-- Custom Styles -->
    <style>
        body {
            font-family: 'Fredoka One', cursive, sans-serif;
            background-color: #0b0712;
            color: #fff;
            user-select: none;
            overflow: hidden;
            touch-action: none;
        }

        .font-arcade {
            font-family: 'Press Start 2P', monospace;
        }

        /* CRT Screen Effect */
        .crt-scanlines::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                        linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
            z-index: 40;
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
        }

        /* Buttons & Neon Effects */
        .arcade-btn {
            box-shadow: 0 6px 0 0 #000;
            transition: all 0.1s ease;
        }
        .arcade-btn:active {
            transform: translateY(4px);
            box-shadow: 0 2px 0 0 #000;
        }
        .neon-glow-cyan { box-shadow: 0 0 15px rgba(6, 182, 212, 0.6); }
        .neon-text-pink { text-shadow: 0 0 8px #ec4899, 0 0 16px #ec4899; }
        .neon-text-yellow { text-shadow: 0 0 8px #eab308, 0 0 16px #eab308; }

        /* Screen Shake Animation */
        .shake { animation: shakeAnim 0.25s ease-in-out; }
        @keyframes shakeAnim {
            0% { transform: translate(0, 0); }
            20% { transform: translate(-8px, 5px); }
            40% { transform: translate(8px, -5px); }
            60% { transform: translate(-5px, 3px); }
            80% { transform: translate(5px, -3px); }
            100% { transform: translate(0, 0); }
        }
    </style>
</head>

