                { prompt: "DEFINITION: A foolish or stupid person", correct: "Nincompoop", wrong: ["Genius", "Scholar", "Expert"] },
                { prompt: "DEFINITION: Empty talk or nonsense", correct: "Poppycock", wrong: ["Wisdom", "Advice", "Help"] },
                { prompt: "DEFINITION: To spend time aimlessly", correct: "Lollygag", wrong: ["Rush", "Hurry", "Sprint"] },
                { prompt: "DEFINITION: Crooked, askew, or awry", correct: "Cattywampus", wrong: ["Straight", "Level", "Even"] },
                { prompt: "DEFINITION: A noisy and overexcited reaction", correct: "Brouhaha", wrong: ["Calm", "Order", "Peace"] },
                { prompt: "DEFINITION: A commotion or fuss, especially caused by conflicting views", correct: "Kerfuffle", wrong: ["Agreement", "Harmony", "Truce"] },
                { prompt: "DEFINITION: Nonsense (British origin)", correct: "Codswallop", wrong: ["Fact", "Truth", "Reality"] },
                { prompt: "DEFINITION: Senseless talk or writing", correct: "Balderdash", wrong: ["Sense", "Reason", "Logic"] }
            ]
        };

        const MOVIE_POPUPS = [
            "IT'S SO FLUFFY! 🦄", "BANANA! 🍌", "YOU'RE A WIZARD! ⚡", 
            "DESPICABLE! 🦹", "MAMMA MIA! 🍄", "MINION POWER! 💛", "10 POINTS! 🏆"
        ];

        /* --- GAME ENGINE & STATE --- */
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        let currentLevel = 1;
        let score = 0;
        let highscore = parseInt(localStorage.getItem('mq_high') || '0');
        let lives = 3;
        let combo = 1;
        let gameActive = false;
        let missionIdx = 0;

        let particles = [];
        let fallingItems = [];
        let lasers = [];
        let invaders = [];
        let mazeGems = [];
        let mazeMonsters = [];
        
        let player = { x: 0, y: 0, w: 60, h: 40, speed: 7 };
        const keys = { left: false, right: false, up: false, down: false, fire: false };

        // Resize Canvas
        function resizeCanvas() {
            canvas.width = canvas.clientWidth;
            canvas.height = canvas.clientHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        /* --- CONTROLS & EFFECTS --- */
        function triggerShake() {
            const body = document.getElementById('main-body');
            body.classList.add('shake');
            setTimeout(() => body.classList.remove('shake'), 250);
        }

        function createExplosion(x, y, color) {
            for (let i = 0; i < 20; i++) {
                particles.push({
                    x: x, y: y,
                    vx: (Math.random() - 0.5) * 9,
                    vy: (Math.random() - 0.5) * 9,
                    color: color,
                    life: 1.0,
                    size: Math.random() * 5 + 3
                });
            }
        }

        function triggerFunnyPopup(text) {
            const pop = document.getElementById('funny-popup');
            document.getElementById('popup-text').innerText = text || MOVIE_POPUPS[Math.floor(Math.random() * MOVIE_POPUPS.length)];
            pop.classList.remove('hidden');
            setTimeout(() => pop.classList.add('hidden'), 1200);
        }

        // Keyboard Controls
        window.addEventListener('keydown', e => {
            if (['ArrowLeft', 'a', 'A'].includes(e.key)) keys.left = true;
            if (['ArrowRight', 'd', 'D'].includes(e.key)) keys.right = true;
            if (['ArrowUp', 'w', 'W'].includes(e.key)) keys.up = true;
            if (['ArrowDown', 's', 'S'].includes(e.key)) keys.down = true;
            if ([' ', 'Enter'].includes(e.key)) keys.fire = true;
        });

        window.addEventListener('keyup', e => {
            if (['ArrowLeft', 'a', 'A'].includes(e.key)) keys.left = false;
            if (['ArrowRight', 'd', 'D'].includes(e.key)) keys.right = false;
            if (['ArrowUp', 'w', 'W'].includes(e.key)) keys.up = false;
            if (['ArrowDown', 's', 'S'].includes(e.key)) keys.down = false;
            if ([' ', 'Enter'].includes(e.key)) keys.fire = false;
        });

        // Touch Controls
        const bindTouch = (id, keyName) => {
            const btn = document.getElementById(id);
            btn.addEventListener('touchstart', (e) => { e.preventDefault(); keys[keyName] = true; });
            btn.addEventListener('touchend', (e) => { e.preventDefault(); keys[keyName] = false; });
            btn.addEventListener('mousedown', () => { keys[keyName] = true; });
            btn.addEventListener('mouseup', () => { keys[keyName] = false; });
        };
        bindTouch('btn-left', 'left');
        bindTouch('btn-right', 'right');
        bindTouch('btn-up', 'up');
        bindTouch('btn-down', 'down');
        bindTouch('btn-action', 'fire');

        /* --- GAME FLOW --- */
        function updateHUD() {
            document.getElementById('hud-score').innerText = String(score).padStart(4, '0');
            document.getElementById('hud-lives').innerText = '❤️'.repeat(Math.max(0, lives));
            document.getElementById('hud-combo').innerText = `x${combo}`;
            document.getElementById('hub-highscore').innerText = String(highscore).padStart(4, '0');
        }

        function showHub() {
            gameActive = false;
            document.getElementById('menu-overlay').classList.remove('hidden');
            document.getElementById('gameover-overlay').classList.add('hidden');
            document.getElementById('prompt-text').innerText = "Select an Arcade Level to Start Playing!";
            updateHUD();
        }

        function startLevel(lvl) {
            currentLevel = lvl;
            score = 0;
            lives = 3;
            combo = 1;
            missionIdx = 0;
            gameActive = true;

            document.getElementById('menu-overlay').classList.add('hidden');
            document.getElementById('gameover-overlay').classList.add('hidden');

            updateHUD();
            initMission();
            requestAnimationFrame(gameLoop);
        }

        function restartLevel() {
            startLevel(currentLevel);
        }

        function gameOver() {
            gameActive = false;
            playSFX('hit');
            triggerShake();
            
            if (score > highscore) {
                highscore = score;
                localStorage.setItem('mq_high', highscore);
            }
            
            document.getElementById('final-score').innerText = score;
            document.getElementById('final-high').innerText = highscore;
            document.getElementById('gameover-overlay').classList.remove('hidden');
        }

        function initMission() {
            const data = MOVIE_DATASET[currentLevel];
            if (missionIdx >= data.length) missionIdx = 0;
            const item = data[missionIdx];

            // Reset Level Arrays
            fallingItems = [];
            lasers = [];
            invaders = [];
            mazeGems = [];
            mazeMonsters = [];

            const words = [item.correct, ...item.wrong].sort(() => Math.random() - 0.5);

            if (currentLevel === 1) {
                // LEVEL 1: BROOM CATCHER
                document.getElementById('prompt-label').innerText = "LEVEL 1 MISSION: CATCH MATCHING TERM";
                document.getElementById('prompt-text').innerText = item.prompt;

                player.w = 70; player.h = 45;
                player.x = canvas.width / 2 - player.w / 2;
                player.y = canvas.height - 60;

                words.forEach((w, i) => {
                    fallingItems.push({
                        text: w,
                        isTarget: (w === item.correct),
                        x: 60 + i * ((canvas.width - 120) / (words.length - 1)),
                        y: -40 - Math.random() * 120,
                        speed: 1.8 + Math.random() * 1.2,
                        r: 34,
                        hitColor: null 
                    });
                });

            } else if (currentLevel === 2) {
                // LEVEL 2: CROSSOVER BLASTER
                document.getElementById('prompt-label').innerText = "LEVEL 2 MISSION: BLAST MATCHING POD";
                document.getElementById('prompt-text').innerText = item.prompt;

                player.w = 40; player.h = 50;
                player.x = canvas.width / 2 - player.w / 2;
                player.y = canvas.height - 60;

                words.forEach((w, i) => {
                    invaders.push({
                        text: w,
                        isTarget: (w === item.correct),
                        x: 60 + i * ((canvas.width - 120) / (words.length - 1)),
                        y: 50 + (i % 2) * 20,
                        w: 90, h: 42,
                        vx: 1.5,
                        hitColor: null
                    });
                });

            } else if (currentLevel === 3) {
                // LEVEL 3: ILLUMINATION LAIR
                document.getElementById('prompt-label').innerText = "LEVEL 3 MISSION: ILLUMINATION LAIR KEYCARD";
                document.getElementById('prompt-text').innerText = item.prompt;

                // Safe spawn position (away from top-left corner items)
                player.w = 32; player.h = 32;
                player.x = 60; player.y = 80;

                words.forEach((word, i) => {
                    mazeGems.push({
                        text: word,
                        isTarget: (word === item.correct),
                        x: 180 + (i * 150) % (canvas.width - 220),
                        y: 140 + (i * 100) % (canvas.height - 200),
                        r: 30,
                        hitColor: null
                    });
                });

                mazeMonsters = [
                    { x: canvas.width / 2, y: canvas.height / 2, vx: 2.5, vy: 0, r: 22 },
                    { x: canvas.width - 100, y: 160, vx: 0, vy: 2.5, r: 22 }
                ];
            }
            
        }

        /* --- RENDER LOOPS --- */
        function gameLoop() {
            if (!gameActive) return;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Particles Render
            particles.forEach((p, index) => {
                p.x += p.vx; p.y += p.vy;
                p.life -= 0.03;
                ctx.fillStyle = p.color;
                ctx.globalAlpha = Math.max(0, p.life);
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
                ctx.fill();
                ctx.globalAlpha = 1.0;
                
                if (p.life <= 0) particles.splice(index, 1);
            });

            if (currentLevel === 1) updateCatcher();
            else if (currentLevel === 2) updateDefender();
            else if (currentLevel === 3) updateMaze();

            requestAnimationFrame(gameLoop);
        }

        // --- LEVEL 1: BROOM CATCHER ---
        function updateCatcher() {
            if (keys.left && player.x > 0) player.x -= player.speed;
            if (keys.right && player.x + player.w < canvas.width) player.x += player.speed;

            // Draw Broom
            ctx.fillStyle = '#ec4899';
            ctx.beginPath();
            ctx.arc(player.x + player.w/2, player.y + player.h/2, player.w/2, 0, Math.PI);
            ctx.fill();
            
            ctx.fillStyle = '#06b6d4';
            ctx.fillRect(player.x + 5, player.y + 5, player.w - 10, 8);

            // Draw Bubbles
            fallingItems.forEach((b) => {
                b.y += b.speed;

                ctx.beginPath();
                ctx.arc(b.x, b.y, b.r, 0, Math.PI*2);
                ctx.fillStyle = b.hitColor || 'rgba(6, 182, 212, 0.85)';
                ctx.fill();
                ctx.strokeStyle = '#38bdf8';
                ctx.lineWidth = 2;
                ctx.stroke();

                ctx.fillStyle = '#fff';
                ctx.font = '11px "Fredoka One"';
                ctx.textAlign = 'center';
                ctx.fillText(b.text, b.x, b.y + 4);

                // Collision
                if (b.y + b.r >= player.y && b.x >= player.x - 10 && b.x <= player.x + player.w + 10) {
                    if (b.isTarget) {
                        b.hitColor = '#eab308';
                        createExplosion(b.x, b.y, '#eab308');
                        playSFX('catch');
                        score += 150 * combo;
                        combo++;
                        triggerFunnyPopup();
                        missionIdx++;
                        setTimeout(initMission, 300);
                    } else {
                        createExplosion(b.x, b.y, '#ef4444');
                        playSFX('hit');
                        triggerShake();
                        lives--;
                        combo = 1;
                        updateHUD();
                        if (lives <= 0) gameOver();
                        else b.y = -50;
                    }
                }

                if (b.y > canvas.height + 40) {
                    b.y = -40;
                    b.x = Math.random() * (canvas.width - 80) + 40;
                }
            });
        }

        // --- LEVEL 2: CROSSOVER BLASTER ---
        function updateDefender() {
            if (keys.left && player.x > 0) player.x -= player.speed;
            if (keys.right && player.x + player.w < canvas.width) player.x += player.speed;

            if (keys.fire) {
                if (!player.lastFire || Date.now() - player.lastFire > 220) {
                    playSFX('laser');
                    lasers.push({ x: player.x + player.w/2, y: player.y, speed: 10 });
                    player.lastFire = Date.now();
                }
            }

            // Draw Laser Wand
            ctx.fillStyle = '#38bdf8';
            ctx.fillRect(player.x + player.w/2 - 4, player.y, 8, player.h);

            // Update Lasers
            lasers.forEach((l, li) => {
                l.y -= l.speed;
                ctx.fillStyle = '#ec4899';
                ctx.fillRect(l.x - 3, l.y, 6, 14);

                invaders.forEach((inv) => {
                    if (l.x >= inv.x - inv.w/2 && l.x <= inv.x + inv.w/2 && l.y <= inv.y + inv.h && l.y >= inv.y) {
                        lasers.splice(li, 1);
                        if (inv.isTarget) {
                            inv.hitColor = '#eab308';
                            createExplosion(inv.x, inv.y + inv.h/2, '#eab308');
                            playSFX('catch');
                            score += 200 * combo;
                            combo++;
                            triggerFunnyPopup();
                            missionIdx++;
                            setTimeout(initMission, 350);
                        } else {
                            createExplosion(inv.x, inv.y + inv.h/2, '#ef4444');
                            playSFX('hit');
                            triggerShake();
                            lives--;
                            combo = 1;
                            updateHUD();
                            if (lives <= 0) gameOver();
                        }
                    }
                });
            });

            // Draw Flying Invader Pods
            invaders.forEach(inv => {
                inv.x += inv.vx;
                if (inv.x > canvas.width - 60 || inv.x < 60) inv.vx *= -1;

                ctx.fillStyle = inv.hitColor || 'rgba(168, 85, 247, 0.9)';
                ctx.fillRect(inv.x - inv.w/2, inv.y, inv.w, inv.h);
                
                ctx.strokeStyle = '#c084fc';
                ctx.lineWidth = 2;
                ctx.strokeRect(inv.x - inv.w/2, inv.y, inv.w, inv.h);

                ctx.fillStyle = '#fff';
                ctx.font = '11px "Fredoka One"';
                ctx.textAlign = 'center';
                ctx.fillText(inv.text, inv.x, inv.y + 25);
            });
        }

        // --- LEVEL 3: ILLUMINATION LAIR ---
        function updateMaze() {
            if (keys.left && player.x > 0) player.x -= player.speed;
            if (keys.right && player.x + player.w < canvas.width) player.x += player.speed;
            if (keys.up && player.y > 0) player.y -= player.speed;
            if (keys.down && player.y + player.h < canvas.height) player.y += player.speed;

            // Draw Minion
            ctx.fillStyle = '#eab308';
            ctx.beginPath();
            ctx.arc(player.x + 16, player.y + 16, 16, 0, Math.PI*2);
            ctx.fill();
            
            ctx.fillStyle = '#1e3a8a';
            ctx.fillRect(player.x + 4, player.y + 18, 24, 12);

            // Render Lair Orbs
            mazeGems.forEach(gem => {
                ctx.beginPath();
                ctx.arc(gem.x, gem.y, gem.r, 0, Math.PI*2);
                ctx.fillStyle = gem.hitColor || 'rgba(14, 116, 144, 0.9)';
                ctx.fill();
                
                ctx.strokeStyle = '#22d3ee';
                ctx.lineWidth = 2;
                ctx.stroke();

                ctx.fillStyle = '#fff';
                ctx.font = '10px "Fredoka One"';
                ctx.textAlign = 'center';
                ctx.fillText(gem.text, gem.x, gem.y + 4);

                // Collision with Minion
                const dist = Math.hypot((player.x + 16) - gem.x, (player.y + 16) - gem.y);
                if (dist < gem.r + 16) {
                    if (gem.isTarget) {
                        gem.hitColor = '#eab308';
                        createExplosion(gem.x, gem.y, '#eab308');
                        playSFX('catch');
                        score += 250 * combo;
                        combo++;
                        triggerFunnyPopup("BANANA! 🍌");
                        missionIdx++;
                        setTimeout(initMission, 350);
                    } else {
                        createExplosion(gem.x, gem.y, '#ef4444');
                        playSFX('hit');
                        triggerShake();
                        lives--;
                        combo = 1;
                        player.x = 40; player.y = 40;
                        updateHUD();
                        if (lives <= 0) gameOver();
                    }
                }
            });

            // Render Patrolling Bots
            mazeMonsters.forEach(m => {
                m.x += m.vx; m.y += m.vy;
                if (m.x < 30 || m.x > canvas.width - 30) m.vx *= -1;
                if (m.y < 30 || m.y > canvas.height - 30) m.vy *= -1;

                ctx.fillStyle = '#f43f5e';
                ctx.beginPath();
                ctx.arc(m.x, m.y, m.r, 0, Math.PI*2);
                ctx.fill();

                const dist = Math.hypot((player.x + 16) - m.x, (player.y + 16) - m.y);
                if (dist < m.r + 16) {
                    playSFX('hit');
                    triggerShake();
                    lives--;
                    player.x = 40; player.y = 40;
                    updateHUD();
                    if (lives <= 0) gameOver();
                }
            });
        }

        // Initialize HUD on load
        updateHUD();
    </script>
</body>
</html>
